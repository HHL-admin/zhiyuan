# 复制为 .env 后按需修改：cp .env.example .env

# ---------- 安全（生产环境必填） ----------
# JWT 签名密钥，生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# 首次启动自动创建平台管理员 admin 的初始密码；留空则随机生成并打印在启动日志里
ADMIN_INITIAL_PASSWORD=

# ---------- 大模型（可留空） ----------
# 留空时由用户在前端「设置」里填写自己的 Key，用户填写的配置优先
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_MODEL=

# ---------- 向量与存储 ----------
# 本地中文向量模型，向量化不调用外部 API
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
CHROMA_PERSIST_DIRECTORY=./data/vectorstore_bge
DOCUMENTS_DIRECTORY=./data/documents

# ---------- 服务 ----------
HOST=0.0.0.0
PORT=8000
RELOAD=true
# 允许访问后端的前端地址（JSON 数组）
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---------- 检索 ----------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4
